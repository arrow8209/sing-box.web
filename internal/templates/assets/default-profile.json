          },
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          }
        ],
        "server": "Fake-IP"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoLocation-!CN"
        ],
        "server": "Remote-DNS"
      }
    ],
    "disable_cache": false,
    "disable_expire": false,
    "independent_cache": false,
    "final": "Remote-DNS"
  },
  "experimental": {
    "cache_file": {
      "cache_id": "ID_template",
